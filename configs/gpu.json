{
  "room_data": "data/rooms.json",
  "device": "cuda:0",
  "seed": 0,
  "rounds": 10000000,
  "checkpoint_period": 500,
  "knot_episodes": [0, 2000000],
  "model": {
    "room_embedding_dim": 16,
    "position_embedding_dim": 16,
    "hidden_layers": 2,
    "hidden_width": 2048
  },
