{
  "room_data": "data/rooms.json",
  "device": "cpu",
  "seed": 0,
  "rounds": 10000000,
  "checkpoint_period": 100,
  "knot_episodes": [0, 200000],
  "model": {
    "room_embedding_dim": 16,
    "position_embedding_dim": 8,
    "hidden_layers": 2,
    "hidden_width": 256
  },
  "optimizer": {
    "learning_rate": {"log": [0.0005, 0.00005]},
    "beta1": 0.9,
    "beta2": 0.999
  },
  "generation": {
    "environment_count": 1024,
    "batches_per_round": 1,
    "temperature": 0.2,
    "log_success_floor": -50.0
  },
  "train": {
    "batch_size": 256,
    "batches_per_round": 20,
    "experience_rounds": 10
  }
}
